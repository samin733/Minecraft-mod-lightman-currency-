package com.samin.villagercurrency;

import io.github.lightman314.lightmanscurrency.api.money.coins.CoinAPI;
import io.github.lightman314.lightmanscurrency.api.money.coins.data.ChainData;
import io.github.lightman314.lightmanscurrency.api.money.coins.data.coin.CoinEntry;
import net.minecraft.resources.ResourceLocation;
import net.minecraft.world.item.Item;
import net.minecraft.world.item.ItemStack;
import net.minecraftforge.registries.ForgeRegistries;

import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;
import java.util.Random;

/**
 * Runtime adapter for Lightman's Currency.
 *
 * Monetary values always come from CoinAPI/ChainData. The only hard-coded
 * information is the identity/order of the six requested denomination items;
 * their actual values are never assumed.
 */
public final class LightmanCurrencyAdapter {
    private static final String MAIN_CHAIN = CoinAPI.MAIN_CHAIN;

    private LightmanCurrencyAdapter() {}

    public static ChainData chain() {
        return CoinAPI.getApi().ChainData(MAIN_CHAIN);
    }

    public static long emeraldCoinValue() {
        for (CoinEntry entry : chain().getAllEntries(true, ChainData.SORT_LOWEST_VALUE_FIRST)) {
            ResourceLocation id = ForgeRegistries.ITEMS.getKey(entry.getCoin());
            if (isNamedDenomination(id, "coin_emerald")) {
                return entry.getCoreValue();
            }
        }
        throw new IllegalStateException("Lightman's Currency main chain has no coin_emerald entry.");
    }

    public static List<CoinEntry> denominations() {
        return new ArrayList<>(chain().getAllEntries(false, ChainData.SORT_LOWEST_VALUE_FIRST));
    }

    /**
     * Selects one denomination whose actual API value exactly divides value and
     * whose resulting stack fits in a normal item stack. Randomness is only
     * among exact representations, so it can never make a trade cheaper.
     */
    public static ItemStack makeExact(long value, int preferredLevel, Random random) {
        if (value <= 0) return ItemStack.EMPTY;

        List<CoinEntry> candidates = exactCandidates(value);
        if (candidates.isEmpty()) return ItemStack.EMPTY;

        int target = Math.max(1, Math.min(6, preferredLevel));
        List<CoinEntry> preferred = new ArrayList<>();
        for (CoinEntry entry : candidates) {
            if (tierFor(ForgeRegistries.ITEMS.getKey(entry.getCoin())) >= target) {
                preferred.add(entry);
            }
        }

        List<CoinEntry> pool = preferred.isEmpty() ? candidates : preferred;
        CoinEntry selected = pool.get(random.nextInt(pool.size()));
        return stackForValue(value, selected);
    }

    /**
     * Candidates for a fixed-value trade (costB/result) or for choosing the
     * denomination used as a dynamic first cost.
     */
    public static List<CoinEntry> exactCandidates(long value) {
        if (value <= 0) return List.of();

        List<CoinEntry> result = new ArrayList<>();
        for (CoinEntry entry : denominations()) {
            long coinValue = entry.getCoreValue();
            if (coinValue <= 0 || value % coinValue != 0) continue;

            long count = value / coinValue;
            if (count >= 1 && count <= 64) {
                result.add(entry);
            }
        }
        result.sort(Comparator.comparingLong(CoinEntry::getCoreValue));
        return result;
    }

    public static ItemStack stackForValue(long value, CoinEntry entry) {
        long coinValue = entry.getCoreValue();
        if (coinValue <= 0 || value <= 0 || value % coinValue != 0) return ItemStack.EMPTY;

        long count = value / coinValue;
        if (count < 1 || count > 64) return ItemStack.EMPTY;
        return new ItemStack(entry.getCoin(), (int) count);
    }

    public static ItemStack stackForValueUsing(ItemStack denomination, long value) {
        if (denomination == null || denomination.isEmpty() || value <= 0) return ItemStack.EMPTY;

        CoinEntry entry = chain().findEntry(denomination);
        if (entry == null) return ItemStack.EMPTY;
        return stackForValue(value, entry);
    }

    public static int tierFor(ResourceLocation id) {
        if (id == null) return 1;
        return switch (id.getPath()) {
            case "coin_copper" -> 1;
            case "coin_iron" -> 2;
            case "coin_gold" -> 3;
            case "coin_emerald" -> 4;
            case "coin_diamond" -> 5;
            case "coin_netherite" -> 6;
            default -> 1;
        };
    }

    private static boolean isNamedDenomination(ResourceLocation id, String path) {
        return id != null && id.getNamespace().equals("lightmanscurrency") && id.getPath().equals(path);
    }

    public static boolean isCurrencyItem(Item item) {
        return CoinAPI.getApi().IsCoin(item, true);
    }
}
